    "version": "0.2.0",
    "configurations": [

        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'audiobook_tagger'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=audiobook-tagger"
                ],
                "filter": {
                    "name": "audiobook_tagger",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'audiobook-tagger' with arguments",
            "cargo": {
                "args": [
                    "build",
                    "--bin=audiobook-tagger",
                    "--package=audiobook-tagger"
                ],
                "filter": {
                    "name": "audiobook-tagger",
                    "kind": "bin"
                }
            },
            "args": ["toml-to-chapters", ".\\test_audiobook\\output-file.m4b", ".\\test_audiobook\\chapters.toml"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'audiobook-tagger'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=audiobook-tagger",
                    "--package=audiobook-tagger"
                ],
                "filter": {
                    "name": "audiobook-tagger",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}